# Скопируйте этот файл в .env и впишите свои значения. Сам .env в git не добавляется.
# Новый ключ: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=впишите-сюда-секретный-ключ
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1 localhost
# Домены, которым разрешено обращаться к API из браузера (через пробел)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# Бот: токен от @BotFather и адрес API
TELEGRAM_BOT_TOKEN=
API_URL=http://127.0.0.1:8000/api
